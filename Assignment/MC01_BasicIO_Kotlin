fun curExchange() : Float{
    var srcAmtPeso : Float
    print("\nForeign Currency Exchange\n" +
            "Source Amount (PHP): ")
    srcAmtPeso = promptFloat()

    print("\nExchanged Currency\n")
    print(String.format("[1] Philippine Peso (PHP) = %.2f\n", srcAmtPeso) +
          String.format("[2] United States Dollar (USD) = %.2f\n", srcAmtPeso * 62.00) +
          String.format("[3] Japanese Yen (JPY) = %.2f\n", srcAmtPeso * 0.40) +
          String.format("[4] British Pound Sterling (GBP) = %.2f\n", srcAmtPeso * 84.00) +
          String.format("[5] Euro (EUR) = %.2f\n", srcAmtPeso * 72.00) +
          String.format("[6] Chinese Yuan Renminni (CNY) = %.2f\n", srcAmtPeso * 9.00))

    print("\n***\n" +
          "Source Currency = Philippine Peso (PHP)\n" +
          String.format("Source Amount (PHP) = %.2f\n", srcAmtPeso))
    return srcAmtPeso
}


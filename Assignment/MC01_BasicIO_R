  printExchangedCurrencyMenu(source)
  cat("\n***\n")
  cat("Source Currency = Philippine Peso (PHP)\n")
  cat(sprintf("Source Amount (PHP) = %.2f\n\n", source))
}

#' Record Exchange Rate 
#'
#' Prompts the user to select a currency, and then prompts an exchange rate numeric value. [REQ-0016], [REQ-0017]
#' @export
#'
recordExchangeRates <- function() {
  printExchangeMenu()
  choice <- getValidChoiceClean(0, 6, "Select Foreign Currency: ")
  currency <- 0.0
  
  if (choice != 0) {
    currency <- getValidAmount("Exchange Rate: ")
    cat("\n***\n")
    cat(sprintf("Select Foreign Currency = [%d]\n", choice))
    cat(sprintf("Exchange Rate = %.2f\n", currency))
  }
}


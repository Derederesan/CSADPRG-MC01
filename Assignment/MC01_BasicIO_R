#' Valid Choice I/O
#'
#' Prints out the currency exchange list with the conversion rates applied for the user.
#'
#' @param lb An integer value representing an inclusive lower bound that getConsoleInput checks for error detection. [REQ-0002], [REQ-0003]
#' @param ub An integer value representing an inclusive upper bound that getConsoleInput checks for error detection.
#'
#' @return The integer value that corresponds to the user's input.
#'
#' @export
#'
getValidChoice <- function(lb, ub) {
  validInput <- FALSE
  valSelect <- -1
  
  while (!validInput) {
    input <- getConsoleInput("Choice: ")
    valSelect <- suppressWarnings(as.integer(input))
    
    if (!is.na(valSelect) && valSelect >= lb && valSelect <= ub) {
      validInput <- TRUE
      cat("\n***\n")
      cat(sprintf("Choice = %d\n", valSelect))
    } else {
      cat("Incorrect input. Please try again.\n")
    }
  }
  return(valSelect)
}

#' Cleaner Valid Choice I/O 
#'
#' Instead of printing lines that help guide the user, only validates specific integer input. 
#'
#' @param lb 		  An integer value representing an inclusive lower bound that getConsoleInput checks for error detection.
#' @param ub		  An integer value representing an inclusive upper bound that getConsoleInput checks for error detection.
#' @param promptText  An empty string that is passed into getConsoleInput for stricter stdin reads.
#'
#' @return The integer value that corresponds to the user's input.
#'
#' @export
#'
getValidChoiceClean <- function(lb, ub, promptText = "") {
  validInput <- FALSE
  valSelect <- -1
  
  while (!validInput) {
    input <- getConsoleInput(promptText)
    valSelect <- suppressWarnings(as.integer(input))

    if (!is.na(valSelect) && valSelect >= lb && valSelect <= ub) {
      validInput <- TRUE
    } else {
      cat("Incorrect input. Please try again.\n")
    }
  }
  return(valSelect)
}

#' Valid Choice I/O For Numeric/Double Value
#'
#' Instead of printing lines that help guide the user, only validates specific numeric input. 
#'
#' @return The numeric/double value that corresponds to the user's input.
#'
#' @param promptText  An empty string that is passed into getConsoleInput for stricter stdin reads.
#' @export
#'
getValidAmount <- function(promptText) {
  validInput <- FALSE
  valAmount <- -1.0
  input = ""
  
  while (!validInput) {
    input <- getConsoleInput(promptText)
    valAmount <- suppressWarnings(as.numeric(input))
    
    if (!is.na(valAmount)) {
      validInput <- TRUE
    } else {
      cat("Incorrect input. Please try again.\n")
    }
  }
  return(valAmount)
}

#' Valid Choice I/O For Name
#'
#' Takes a string, and uses nchar as a way to count the number of characters present in the stdin, ensures it is within maxLen.
#'
#' @param promptText  An empty string that is passed into getConsoleInput for stricter stdin reads.
#' @param maxLen      A defined integer value that determines the maximum size of the string. 
#'
#' @return A validated string of characters.
#'
#' @export
#'
getValidName <- function(promptText, maxLen) {
  validFlag <- FALSE
  nameBuffer <- ""
  
  while (!validFlag) {
    nameBuffer <- getConsoleInput(promptText)
    if (nchar(nameBuffer) > 0 && nchar(nameBuffer) <= maxLen) {
      validFlag <- TRUE
    }
  }
  return(nameBuffer)
}

#' Register Account
#'
#' Prompts the user to input an account name, and then prints their resulting output [REQ-0004], [REQ-0005], [REQ-0006]
#'
#' @param maxLen      A defined integer value that determines the maximum size of the string. 
#'
#' @return The validated account name string value associated with the user's input.
#'
#' @export
#'
registerAccountName <- function(maxLen) {
  accountName = ""
	
  cat("Register Account Name\n")
  accountName <- getValidName("Account Name: ", maxLen)
  cat("\n***\n")
  cat(sprintf("Account Name = %s\n", accountName))
  
  return(accountName)
}

#' Deposit Amount
#'
#' Prompts the user to input a numeric/double value that will be added to their current held balance. [REQ-0008], [REQ-0009] [REQ-0010]
#'
#' @param accountName    The string value that represents the current user's account name from main.
#' @param balance		 A numeric value that represents the user's currently held balance from main.
#'
#' @return The new balance value after being evaluated by the function.
#'
#' @export
#'
depositAmount <- function(accountName, balance) {
  valDeposit <- 0.0

  cat("Deposit Amount\n")
  cat(sprintf("Account Name: %s\n", accountName))
  cat(sprintf("Current Balance: %.2f\n", balance))
  cat("Currency: PHP\n\n")
  
  valDeposit <- getValidAmount("Deposit Amount: ")
  balance <- as.numeric(balance + valDeposit)
  
  cat("\n***\n")
  cat(sprintf("Account Name = %s\n", accountName))
  cat(sprintf("Deposit Amount = %.2f\n", valDeposit))
  
  return(balance) 
}
#' Withdraw Amount
#'
#' Prompts the user to input a numeric/double value that will be subtracted from their current held balance. [REQ-0012], [REQ-0013], [REQ-0014]
#'
#' @param accountName    The string value that represents the current user's account name from main.
#' @param balance		 A numeric value that represents the user's currently held balance from main.
#'
#' @return The new balance value after being evaluated by the function.
#'
#' @export
#'
withdrawAmount <- function(accountName, balance) {
  valWithdraw <- 0.0

  cat("Withdraw Amount\n")
  cat(sprintf("Account Name: %s\n", accountName))
  cat(sprintf("Current Balance: %.2f\n", balance))
  cat("Currency: PHP\n\n")
  
  valWithdraw <- getValidAmount("Withdraw Amount: ")
  balance <- as.numeric(balance - valWithdraw) 
  
  cat("\n***\n")
  cat(sprintf("Account Name = %s\n", accountName))
  cat(sprintf("Withdraw Amount = %.2f\n", valWithdraw))
  
  return(balance)
}

#' Currency Exchange
#'
#' Prompts the user to input a source amount, and then calculates the post-conversion value [REQ-0019], [REQ-0020]
#' @export

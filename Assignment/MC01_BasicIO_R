#' Main Program Function
#'
#' Handles the main running of the banking exchange program. [REQ-0001], [REQ-0002], [REQ-0003], [REQ-0004], [REQ-0007], [REQ-0011], [REQ-0015], [REQ-0018]
#' @export
#'
main <- function() {
  accountName <- ""
  runningFlag <- TRUE
  choice <- -1
  balance <- 1000.00
  MAX_NAME_LEN <- 100
  
  while (runningFlag) {
    printNavMenu()
    choice <- getValidChoice(0, 6)
    
    if (choice != 0) {
      if (choice == 1) {
        accountName <- registerAccountName(MAX_NAME_LEN)
      } else if (choice == 2) {
        balance <- depositAmount(accountName, balance)
      } else if (choice == 3) {
        balance <- withdrawAmount(accountName, balance)
      } else if (choice == 4) {
        currencyExchange()
      } else if (choice == 5) {
        recordExchangeRates()
      } else if (choice == 6) {
        showInterestAmount()
      }
    } else {
      runningFlag <- FALSE
    }
  }
  cat("Exiting..\n")
}

main()

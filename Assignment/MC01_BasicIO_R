#' Clean Console Input
#'
#' Reads specifically only one non-null terminated string until a ' ' is read. 
#' @return a given string value from stdin.
#' @export
#'

getConsoleInput <- function(promptText) {
  input <- ""
  cat(promptText)
  input <- readLines("stdin", n = 1) 
  if (length(input) == 0) return("") 
  return(input)
}


/**
 * @brief Traversal function to guide the user to different transaction selections.
 * 
 */
 
void transactionSelect(int choice, char *accountName, double *balance, double *globalCurrency){
	switch(choice){
		case 1:
			registerAccountName(accountName);
			break;
		case 2:
			depositAmount(accountName, balance);
			break;
		case 3:
			withdrawAmount(accountName, balance);
			break;
		case 4:
			currencyExchange(globalCurrency);
			break;
		case 5:
			recordExchangeRates(globalCurrency);
			break;
		case 6:
			showInterestAmount();
			break;
		default:
			printf("ERROR: Invalid selection.\n");
			break;
	}
}
 
int main(){
	char accountName[MAX_NAME_LEN + 1] = {0};
	int runningFlag = 1;
	int choice = -1;
	double balance = 1000.00;
	double globalCurrency[6] = {0};
	
	while(runningFlag){
		printNavMenu();
		choice = getValidChoice(0, 6);
		if (choice){
			transactionSelect(choice, accountName, &balance, globalCurrency);
		} else {
			runningFlag = 0;
		}
	}
	printf("Exiting..\n");
	return 0;
}

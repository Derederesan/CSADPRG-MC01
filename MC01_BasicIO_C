/**
 * @brief Records the user's input for a global currency's exchange value.
 * 
 */

void recordExchangeRates(double *globalCurrency){
	int validFlag = 0;
	int choice = -1;
	double currency = 0;
	
	while(!validFlag){
		printExchangeMenu();
		printf("Select Foreign Currency: ");
		
		choice = getValidChoiceClean(0,6);
		if(choice){
			printf("Exchange Rate: ");
			currency = getValidAmount();
			printf("\n***\n");
			printf("Select Foreign Currency = [%d]\n", choice);
			printf("Exchange Rate = %.2lf\n", currency);
			globalCurrency[choice-1] = currency;
			validFlag = 1;
		} else {
			validFlag = 1;
		}
	}
}

